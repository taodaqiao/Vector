<?xml version="1.0" encoding="utf-8"?>
<!-- The status bar icon. A flat ring with a centre dot: it has to survive being drawn at
     24 by 24 pixels in one colour, so anything with interior detail turns into a blob.
     It is deliberately the most ordinary glyph that still reads as "a service is running" —
     an icon that matches a particular project's artwork is itself an identifier. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2a10,10 0 1,0 0,20a10,10 0 1,0 0,-20zM12,5a7,7 0 1,1 0,14a7,7 0 1,1 0,-14z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,9.6a2.4,2.4 0 1,0 0,4.8a2.4,2.4 0 1,0 0,-4.8z" />
</vector>
