<?xml version="1.0" encoding="utf-8"?>
<!--
    Neutral launcher glyph.

    The previous foreground was the Winged Victory of Samothrace, the mark the
    framework inherits from its upstream.  Any app holding QUERY_ALL_PACKAGES can
    pull this drawable back out of PackageManager and template-match it, so the
    label being neutral bought nothing while the icon still answered "which
    framework is installed".  A generic gauge says nothing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M30,56 A24,24 0 0,1 78,56"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#3A4353"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <path
        android:pathData="M50,59 L58,59 L69,33 Z"
        android:fillColor="#3A4353" />

    <path
        android:pathData="M54,50 A6,6 0 1,0 54,62 A6,6 0 1,0 54,50 Z"
        android:fillColor="#3A4353" />

    <path
        android:pathData="M30,66 L30,72"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#3A4353"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M78,66 L78,72"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#3A4353"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
</vector>
